{
  "name": "token-sweeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "npx --yes @cloudflare/next-on-pages@1.13.16 && node scripts/harden-pages.mjs && node scripts/verify-pages.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=2 src/lib/*.test.mjs edge/discovery-gateway.test.mjs scripts/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.28.4",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.363.0",
    "next": "15.5.29",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.9.0",
    "wagmi": "^2.5.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^8",
    "eslint-config-next": "14.1.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
